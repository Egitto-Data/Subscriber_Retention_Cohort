table 'Subscription Cohort Analysis Data'
	lineageTag: 74501c79-db92-4ee4-b353-22084cf2ccbf

	measure 'Customer Retention Volume' = ```
			
			VAR CurrentCohortMonth = SELECTEDVALUE ( 'Subscription Cohort Analysis Data'[Created Date (SOM)] )
			VAR CurrentTenureMonth = SELECTEDVALUE ( 'Subscription Cohort Analysis Data'[Month List] )
			RETURN
			CALCULATE (
			    DISTINCTCOUNT ( 'Subscription Cohort Analysis Data'[customer_id] ),
			    FILTER (
			        'Subscription Cohort Analysis Data',
			        'Subscription Cohort Analysis Data'[Created Date (SOM)] = CurrentCohortMonth
			            && 'Subscription Cohort Analysis Data'[Month List] = CurrentTenureMonth
			    )
			)
			
			```
		formatString: 0
		lineageTag: 4e94aaeb-86be-47e5-bc39-21403ade7717

	measure 'Customer Retention %' = ```
			
			VAR FirstMonthSubscriptionVolume = 
			CALCULATE(
			    DISTINCTCOUNT(
			        'Subscription Cohort Analysis Data'[customer_id]
			    ),
			    ALLEXCEPT(
			        'Subscription Cohort Analysis Data',
			        'Subscription Cohort Analysis Data'[Created Date (SOM)]
			    )
			)
			VAR Ratio = 
			DIVIDE(
			    [Customer Retention Volume],
			    FirstMonthSubscriptionVolume
			)
			RETURN Ratio
			
			```
		formatString: 0%;-0%;0%
		lineageTag: e66e000a-ef1b-496c-a48e-2f05e499f3f4

