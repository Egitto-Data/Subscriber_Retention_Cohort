	partition 'Subscription Cohort Analysis Data' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("G:\Subscriber_Retention_Cohort\dataset\StreamingVideoSubscriptions\Subscription Cohort Analysis Data.csv"),[Delimiter=",", Columns=6, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"customer_id", Int64.Type}, {"created_date", type date}, {"canceled_date", type date}, {"subscription_cost", Currency.Type}, {"subscription_interval", type text}, {"was_subscription_paid", type text}}),
				    #"Filtered Rows" = Table.SelectRows(#"Changed Type", each ([was_subscription_paid] = "Yes")),
				    #"Replaced Value" = Table.ReplaceValue(#"Filtered Rows",null,#date(2023, 9, 30),Replacer.ReplaceValue,{"canceled_date"}),
				    #"Sorted Rows" = Table.Sort(#"Replaced Value",{{"canceled_date", Order.Ascending}}),
				    #"Inserted Start of Month" = Table.AddColumn(#"Sorted Rows", "Start of Month", each Date.StartOfMonth([created_date]), type date),
				    #"Renamed Columns" = Table.RenameColumns(#"Inserted Start of Month",{{"Start of Month", "Created Date (SOM)"}}),
				    #"Added Custom" = Table.AddColumn(#"Renamed Columns", "Month Span", each 12 * (Date.Year([canceled_date]) - Date.Year([created_date]))
				+ (Date.Month([canceled_date]) - Date.Month([created_date]))
				+ (if Date.Day([canceled_date]) < Date.Day([created_date]) then -1 else 0)
				+ 1),
				    #"Added Custom1" = Table.AddColumn(#"Added Custom", "Month List", each List.Numbers(1, [Month Span]), type list),
				    #"Expanded Month List" = Table.ExpandListColumn(#"Added Custom1", "Month List"),
				    #"Filtered Rows1" = Table.SelectRows(#"Expanded Month List", each true),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Filtered Rows1",{{"Month Span", Int64.Type}, {"Month List", Int64.Type}, {"Created Date (SOM)", type date}})
				in
				    #"Changed Type1"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

